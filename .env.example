# Copy this file to .env for local runs. Do not commit real credentials.

# Google Sheets destination. Use the web app URL from the Apps Script deployment.
NICKEL_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/replace-with-your-deployment-id/exec
NICKEL_SHEETS_SHARED_SECRET=replace-with-a-random-secret

# Set this to true when you only want Google Sheets updates and no email.
NICKEL_DISABLE_EMAIL=true

# Optional email destination. Leave disabled unless SMTP is working.
# NICKEL_SMTP_HOST=smtp.example.com
# NICKEL_SMTP_PORT=587
# NICKEL_SMTP_USERNAME=alerts@example.com
# NICKEL_SMTP_PASSWORD=replace-with-your-smtp-app-password
# NICKEL_EMAIL_FROM=alerts@example.com
# NICKEL_EMAIL_TO=you@example.com
# NICKEL_SMTP_STARTTLS=true
# NICKEL_SMTP_SSL=false

# GitHub Actions runs once per schedule, so the interval only matters for
# long-running local/server deployments.
NICKEL_INTERVAL_MINUTES=1440
